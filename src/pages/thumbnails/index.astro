---
// The covers. Each one shown at the shape it really is, with its pixel size,
// its safe area if the platform crops, and both files to download.

import Kit from "../../layouts/Kit.astro";
import { COVERS, NO_COVER } from "../../lib/assets.ts";
import { PLATFORMS } from "../../lib/platforms.ts";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Kit
  title="Thumbnails"
  lead="One template, drawn at each platform's size. Where a platform crops — YouTube, Facebook, Eventbrite — the lockup sits inside the part that always shows."
>
  <div class="panel" style="margin-top:24px">
    <p style="margin:0;color:var(--muted)">
      {COVERS.length} covers. Sizes live in <span class="mono">src/lib/assets.ts</span>; <span class="mono">npm run assets</span> redraws every file from them, so a platform changing its dimensions is a one-line edit.
    </p>
  </div>

  <h2>Every profile, and what it needs</h2>
  <p class="note">One row per platform we hold a handle on, with the file that fills each slot. Sizes are the platform's own published recommendation, checked September 2026.</p>
  <div class="grid cols-2" style="margin-top:14px">
    {PLATFORMS.map((p) => (
      <div class="panel">
        <div style="display:flex;justify-content:space-between;align-items:baseline;gap:10px">
          <p style="margin:0"><strong>{p.name}</strong> <span class="mono">{p.handle}</span></p>
          <span class="pill" style={p.status === "todo" ? "color:#fbbf24;border-color:#3f3113" : ""}>{p.status === "todo" ? "not opened" : "live"}</span>
        </div>
        <ul style="margin:12px 0 0;padding:0;list-style:none">
          {p.needs.map((n) => (
            <li style="display:flex;justify-content:space-between;gap:10px;padding:5px 0;border-top:1px solid var(--rule-soft, #1b1b20);font-size:13px">
              <span>{n.slot}<br /><span class="mono">{n.size}</span></span>
              {n.file && <a class="dl" href={`${base}/kit/${n.file}.png`} download style="align-self:center;white-space:nowrap">{n.file}</a>}
            </li>
          ))}
        </ul>
        {p.note && <p class="note" style="margin-top:10px">{p.note}</p>}
      </div>
    ))}
  </div>

  {COVERS.map((c) => (
    <section style="margin-top:32px">
      <div style="display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap">
        <h2 style="margin:0">{c.platform} <span style="color:var(--dim);font-weight:400">· {c.slot}</span></h2>
        <span class="mono">{c.w}×{c.h}{c.safe && ` · safe ${c.safe.w}×${c.safe.h}`}</span>
      </div>
      <img class="shot" style="margin-top:12px" src={`${base}/kit/${c.slug}.png`} alt={`${c.platform} ${c.slot}`} width={c.w} height={c.h} loading="lazy" />
      <div style="display:flex;gap:8px;align-items:center;margin-top:10px;flex-wrap:wrap">
        <a class="dl" href={`${base}/kit/${c.slug}.png`} download>PNG</a>
        <a class="dl" href={`${base}/kit/${c.slug}.svg`} download>SVG</a>
        {c.note && <span class="note">{c.note}</span>}
      </div>
    </section>
  ))}

  <h2>No cover slot</h2>
  <div class="panel">
    {NO_COVER.map((p) => (
      <p style="margin:0 0 6px"><strong>{p.platform}</strong> <span class="mono">{p.handle}</span> — <span style="color:var(--muted)">{p.why}</span></p>
    ))}
  </div>
</Kit>
